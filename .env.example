# Copy to .env for local use, and add the same four values in Vercel > Settings > Environment Variables.
# Never commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
SESSION_SECRET=replace-with-a-long-random-string-of-24-or-more-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
